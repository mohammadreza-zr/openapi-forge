{
  "name": "@mrzr/openapi-forge",
  "version": "0.1.0",
  "description": "Generate a typed TypeScript API layer — models, request functions, query keys and hooks for React, Vue, Svelte, Solid or Angular Query, or SWR — from OpenAPI / Swagger documents.",
  "keywords": [
    "openapi",
    "swagger",
    "codegen",
    "typescript",
    "react-query",
    "tanstack-query",
    "vue-query",
    "svelte-query",
    "solid-query",
    "angular-query",
    "swr",
    "axios",
    "angular"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammadreza-zr/openapi-forge.git"
  },
  "homepage": "https://github.com/mohammadreza-zr/openapi-forge#readme",
  "bugs": {
    "url": "https://github.com/mohammadreza-zr/openapi-forge/issues"
  },
  "type": "module",
  "bin": {
    "openapi-forge": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "conformance": "npm run build && node scripts/conformance.mjs",
    "prepublishOnly": "npm test && npm run conformance"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "prettier": ">=3"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@readme/oas-examples": "^8.2.2",
    "@tanstack/angular-query-experimental": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/solid-query": "^5.105.0",
    "@tanstack/svelte-query": "^6.3.6",
    "@tanstack/vue-query": "^5.105.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.20.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.2",
    "swr": "^2.5.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true
  }
}
